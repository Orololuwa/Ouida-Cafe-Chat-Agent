MCP_TOKEN=
# Optional locally; Docker sets DB_PATH=/data/ouida.db
DB_PATH=data/ouida.db

# Paystack test mode only: the server refuses to start unless this begins with sk_test_
PAYSTACK_SECRET_KEY=sk_test_
# Where Paystack sends customers back to (/paid). Locally: http://127.0.0.1:8020
PUBLIC_BASE_URL=https://ouida-mcp.eleven-sports.app
# Domain for the generated per-order customer emails Paystack requires
PAYMENT_EMAIL_DOMAIN=orders.eleven-sports.app
